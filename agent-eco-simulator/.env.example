# =============================================================
# Agent Eco Simulator Configuration
# (forked from MiroFish-Offline)
# =============================================================
# Copy this file to .env and fill in your keys.
# =============================================================

# ===== LLM Configuration (Ollama — local, no cloud needed) =====
# Simulation agents use the OpenAI-compatible Ollama endpoint.
# Default model: gemma3:4b (pull with: ollama pull gemma3:4b)
# For Docker: replace localhost with the ollama service name.
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=gemma3:4b
SIM_MODEL=gemma3:4b
# Context window for Ollama (prevents prompt truncation):
OLLAMA_NUM_CTX=8192

# ===== Anthropic API (Phase 1 narrative runner only — optional) =====
# Only required for runner_phase1.py (prompt-only scenario analysis).
# The Phase 2 economic engine uses Ollama above, not Anthropic.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== Neo4j Configuration =====
# For Docker: use service name "neo4j" instead of "localhost"
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish

# ===== Embedding Configuration =====
# Uses Ollama's embedding endpoint
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
# For Docker: EMBEDDING_BASE_URL=http://ollama:11434

# ===== OASIS / CAMEL-AI Configuration =====
# CAMEL-AI reads OPENAI_API_KEY and OPENAI_API_BASE_URL
# Points to same local Ollama server
OPENAI_API_KEY=ollama
OPENAI_API_BASE_URL=http://localhost:11434/v1

# ===== Docker-mode overrides =====
# Uncomment these when running ALL services inside Docker
# (backend container talks to neo4j/ollama containers by service name)
# LLM_BASE_URL=http://ollama:11434/v1
# NEO4J_URI=bolt://neo4j:7687
# EMBEDDING_BASE_URL=http://ollama:11434
# OPENAI_API_BASE_URL=http://ollama:11434/v1
